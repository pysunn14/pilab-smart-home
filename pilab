def port_number(value):
    try:
        port = int(value)
    except ValueError:
        port = -1
    if not 0 <= port <= 65535:
        raise argparse.ArgumentTypeError("포트는 0~65535 사이의 정수여야 합니다.")
    return port


def positive_count(value):
    try:
        count = int(value)
    except ValueError:
        count = 0
    if count < 1:
        raise argparse.ArgumentTypeError("입력 수는 1 이상의 정수여야 합니다.")
    return count


def serve(args, parser):
    from lab.control_web import dashboard_handler
    from lab.session import ExperimentSession
    from lab.web_room import WebRoom
    from urllib.parse import urlsplit

    external_origin = args.control_origin
    if bool(external_origin) != bool(args.operator_file) or (external_origin and not (args.control or args.room)):
        parser.error("외부 제어에는 --control 또는 --room과 --control-origin, --operator-file을 지정하세요.")
    if args.room and (args.spring_receiver or args.room_file is not None):
        parser.error("--room은 별도의 센서 입력과 네 Pi를 실행합니다. --spring-receiver, --room-file과 함께 사용할 수 없습니다.")
    if args.spring_receiver and not args.control:
        parser.error("--spring-receiver에는 --control을 함께 지정하세요.")
    operator = None
    if external_origin:
        parsed = urlsplit(external_origin)
        if parsed.scheme not in {"http", "https"} or not parsed.hostname or parsed.path or parsed.query or parsed.fragment or parsed.username:
            parser.error("--control-origin에는 경로 없는 HTTP 또는 HTTPS 주소를 지정하세요.")
        try:
            operator = args.operator_file.read_text().strip()
        except OSError as error:
            parser.error(f"제어 계정 파일을 읽을 수 없습니다. {error}")
        if not operator or len(operator.splitlines()) != 1:
            parser.error("--operator-file에는 제어를 허용할 계정 하나를 지정하세요.")
    port = args.port if args.port is not None else 8795 if args.room else DEFAULT_PORT
    prefix = args.subnet_prefix or ("172.30.250" if args.room else "172.30.252")
    if args.room:
        session = WebRoom(WEB_DIRECTORY.parent, args.runs_dir, prefix)
    elif args.control:
        session = ExperimentSession(WEB_DIRECTORY.parent, args.runs_dir, prefix, spring_receiver=args.spring_receiver)
    else:
        session = None
    try:
        server = ThreadingHTTPServer((HOST, port), None)
        try:
            server.RequestHandlerClass = dashboard_handler(
                WEB_DIRECTORY, session, external_origin, operator, room_file=args.room_file,
                room_provider=session.room_for if args.room else None, auto_blind=args.room,
            )
        except OSError:
            server.server_close()
            raise
    except OSError as error:
        parser.exit(1, f"PiLab 웹 서버를 시작할 수 없습니다 ({HOST}:{port}). {error}\\n")

    def shutdown(_signum, _frame):
        raise KeyboardInterrupt

    previous_handler = signal.signal(signal.SIGTERM, shutdown)
    try:
        with server:
            page = "/room.html" if args.room else "/"
            print(f"PiLab 대시보드  http://{HOST}:{server.server_port}{page}", flush=True)
            print("종료 Ctrl+C", flush=True)
            server.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        signal.signal(signal.SIGTERM, previous_handler)
        if session is not None:
            session.close()


