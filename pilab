        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        default_output = Path.home() / ".local/state/pilab/runs" / f"{stamp}-{uuid4().hex[:6]}"
        repo = args.legacy_repo.resolve()
        output = (args.output or default_output).resolve()
        try:
            if args.lab_command == "benchmark":
                report = benchmark.run(repo, output, args.subnet_prefix, args.samples, args.seed)
                if args.check_slo:
                    states = {target["status"] for target in report["slo"].values()}
                    if states != {"pass"}:
                        parser.exit(2 if "fail" in states else 3)
            elif args.lab_command == "receiver-benchmark":
                receiver_benchmark.run(repo, output, args.subnet_prefix, args.samples)
            elif args.lab_command == "receiver-compare":
                receiver_compare.run(repo, output, args.subnet_prefix, args.samples)
            elif args.lab_command == "light-benchmark":
                light_benchmark.run(repo, output, args.subnet_prefix, args.samples)
            elif args.lab_command == "integrated-smoke":
                integrated_smoke.run(repo, output, args.subnet_prefix)
            elif args.lab_command == "air-servo-smoke":
                air_servo_smoke.run(repo, output, args.subnet_prefix, args.angle)
            elif args.lab_command == "air-auto-servo-smoke":
                air_servo_smoke.run_auto(repo, output, args.subnet_prefix)
            elif args.lab_command in ("fire-room", "light-room"):
                sensor_room.run(repo, output, args.subnet_prefix, args.port, args.room_node, auto_blind=args.auto_blind)
            elif args.lab_command == "room":
                connected_room.run(repo, output, args.subnet_prefix, args.port)
            elif args.lab_command == "fire-alarm-smoke":
                fire_alarm_smoke.run(repo, output, args.subnet_prefix)
            elif args.lab_command in telemetry_smoke.TELEMETRY_ROLES:
                if args.hold_down_until_exhausted and not args.spring_restart:
                    parser.error("--hold-down-until-exhausted에는 --spring-restart가 필요합니다")
                if args.spring_restart:
                    telemetry_restart.run(repo, output, args.subnet_prefix, args.lab_command,
                                          hold_down=args.hold_down_until_exhausted)
                else:
                    telemetry_smoke.run(repo, output, args.subnet_prefix, args.lab_command,
                                        idle_reconnect=args.idle_reconnect)
            elif args.lab_command == "light-ack-delay":
                light_ack_delay.run(repo, output, args.subnet_prefix)
            elif args.lab_command == "light-ack-retry":
                if args.recover and args.drop_count != 2:
                    parser.error("--recover에는 --drop-count 2가 필요합니다")
                light_ack_retry.run(repo, output, args.subnet_prefix, args.drop_count, args.timeout_ms,
                                    recover=args.recover)
            elif args.lab_command == "light-reconnect":
                if args.spring_restart or args.spring_restart_pending:
                    light_spring_restart.run(repo, output, args.subnet_prefix, pending=args.spring_restart_pending)
                elif args.reject_attempts:
                    light_reconnect_retry.run(repo, output, args.subnet_prefix, args.reject_attempts)
                else:
                    light_reconnect.run(repo, output, args.subnet_prefix, pending=args.pending,
                                        undelivered=args.undelivered, restart=args.restart)
            elif args.lab_command == "p0":
                if args.scenario in ("all", "soak") and max(args.interval, args.warmup) >= args.duration:
                    parser.error("안정성 관측 시간은 관측 간격과 안정화 시간보다 길어야 합니다.")
                p0.run(repo, output, args.subnet_prefix, args.scenario, args.repeats, args.samples,
                       args.seed, args.duration, args.interval, args.warmup)
            else:
                run(repo, output, args.subnet_prefix)
        except (OSError, RuntimeError, ValueError, SubprocessError) as error:
            parser.exit(1, f"PiLab 통합 실행 실패. {error}\n")
        return

    if args.command == "web":
        serve(args, parser)
        return

    if sys.stdout.isatty():
        print("\033[38;2;207;157;191m" + BANNER + "\033[0m")
    else:
        print(BANNER)
    print(f"\n  {invocation} web     로컬 대시보드 실행")
    print(f"  {invocation} lab smoke  통합 실행 검증")
    print(f"  {invocation} lab benchmark  버튼→LED 기준선 측정")
    print(f"  {invocation} lab p0  제어·복구·안정성 측정")
    print(f"  {invocation} --help  명령 도움말")


if __name__ == "__main__":
    main()
