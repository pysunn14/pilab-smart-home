FROM python:3.11-trixie@sha256:55c475496e35ad8d898659c85f92b42d3b1c58f25f5d79023baf0840b0b4a462

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcurl4-openssl-dev libjson-c-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY . .
RUN make -C firepi fire-node

ENTRYPOINT ["/app/firepi/build/fire-node", "ws://spring:8080/socket"]
