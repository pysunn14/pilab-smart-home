{
  "uid": "pilab-sqlite",
  "title": "PiLab · 센서 상태와 SQLite 저장",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 3,
      "title": "센서 연결 상태",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "pilab-prometheus" },
      "fieldConfig": {
        "defaults": {
          "noValue": "관측 없음",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "연결 끊김", "color": "red", "index": 0 },
                "1": { "text": "연결됨", "color": "green", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pilab_sensor_websocket_connected",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 4,
      "title": "마지막 정상 샘플 경과 시간",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "pilab-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "관측 없음",
          "mappings": [
            {
              "type": "value",
              "options": { "-1": { "text": "미수신", "index": 0 } }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(time() - (pilab_sensor_last_sample_timestamp_seconds > 0), 0) or ((pilab_sensor_last_sample_timestamp_seconds == 0) - 1)",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "none",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 1,
      "title": "저장 결과 · 현재 Spring 실행",
      "type": "stat",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "pilab-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node, result) (pilab_sensor_sqlite_write_seconds_count)",
          "legendFormat": "{{node}} · {{result}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 2,
      "title": "SQLite 저장 지연 · p95 / p99",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 11 },
      "datasource": { "type": "prometheus", "uid": "pilab-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (node, le) (rate(pilab_sensor_sqlite_write_seconds_bucket{result=\"stored\"}[$__rate_interval])))",
          "legendFormat": "{{node}} · p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (node, le) (rate(pilab_sensor_sqlite_write_seconds_bucket{result=\"stored\"}[$__rate_interval])))",
          "legendFormat": "{{node}} · p99"
        }
      ]
    }
  ]
}
